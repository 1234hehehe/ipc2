sdcard_format_respawn()
{
        local LastSDExist=0;
        local CurSDExist=0;
        
        devmem 0x10011138 32 0xfff
        devmem 0x10011134 32 0xaaa
        
        mount_mmc
        
        if [ -b /dev/mmcblk0 ] ; then
                let LastSDExist=1;
        fi
        
        sleep 20;

        while true; 
        do
        {
                {
                        if [ -b /dev/mmcblk0 ] ; then
                                let CurSDExist=1;
                        else
                                let CurSDExist=0;
                        fi
					
                        echo "LastSDExist=$LastSDExist,CurSDExist=$CurSDExist";
					
                        if [ $LastSDExist -ne $CurSDExist ] ; then
                                if [ $CurSDExist -eq 1 ] ; then
                                        echo 3 > /proc/sys/vm/drop_caches
                                        umount /tmp/mmc/mmc1; rm -rf /tmp/mmc/mmc1;
                                        mount_mmc
                                else
                                        killall ovfs_record
                                        killall ovfs_filemanage
                                        killall ovfs_eventlog
										uritool put /webserver/devicestatus {\"SDCardStatus\":-1}
                                fi

                                LastSDExist=$CurSDExist;
                        elif [ $CurSDExist -eq 1 ] ; then
                                proc_name="/root/bin/ovfs_record";
                                pidof ${proc_name##*/} > /dev/null;ret=$?;
                                if [ ${ret} -ne 0 ] ; then
				                        	echo "$(date) Starting up $proc_name ....";
				                        	chmod +x ${proc_name};
				                        	${proc_name} &
                                fi

								proc_name="/root/bin/ovfs_eventlog";
                                pidof ${proc_name##*/} > /dev/null;ret=$?;
                                if [ ${ret} -ne 0 ] ; then
				                        	echo "$(date) Starting up $proc_name ....";
				                        	chmod +x ${proc_name};
				                        	${proc_name} &
                                fi
                        fi
                }
                sleep 5;
        }
        done
}

guard_process()
{
        local proc_name;
        local param1;
        local param2;
        local param3;

        local curtimev1=5;
        local totaltimev1=5;
        
        local curtimev2=0;
        local totaltimev2=5;
        local curRestartTimev2=0
        local totalRestartTimev2=20
        
        local curtimev3=5;
        local totaltimev3=5;
        local curRestartTimev3=0;
        local totalRestartTimev3=20;
        
        local curEthIn=0;
        local lstEthIn=0;
        local curtimev4=0;
        local totaltimev4=0;

        while true; 
        do
        {
                {
                        if [ $curtimev1 -ge $totaltimev1 ] ; then
                            need=0;
                            for i in $(netstat -ntple | grep media | awk -F ' ' '{print $2}');
                            do
                                    #echo $i;
                                    if [ $i -gt 3 ];
                                    then
                                            echo "listen queue > 3 , need strace";
                                            need=1;
                                    fi;
                            done;
                            if [ $need == 1 ];
                            then
                                    strace -fp $(pidof ovfs_mediaserver) -c -o /dev/null & sleep 5;pkill strace;
                            fi
                            let curtimev1=0;
                        else
                        		let curtimev1++;   
                        fi  
                }
                
                {
                        proc_name="/root/nginx/sbin/nginx"
                        param1="-p"
                        param2="/root/nginx/"
                        param3=""
                
                        if [ $curtimev2 -gt $totaltimev2 ] ; then
                                #str=$(ps); echo ${str} | grep -q $proc_name; ret=$?;
                                pidof ${proc_name##*/} > /dev/null;ret=$?;
                                if [ ${ret} -ne 0 ] ; then
                                        echo "name=$proc_name parm1=$param1 parm2=$param2 param3=$param3"
                                        echo "$(date) Starting up $proc_name .... $curRestartTimev2/$totalRestartTimev2";
                                        chmod +x ${proc_name};
                                        ${proc_name} $param1 $param2 $param3 &
                                        let curRestartTimev2++;
                                fi
                                let curtimev2=0;
                        else
                                let curtimev2++;   
                        fi    
                        
                        if [ $curRestartTimev2 -ge $totalRestartTimev2 ] ; then
                                echo "$(date) $proc_name starup fail. need reboot";
                                reboot;
                        fi
                }
if false; then              
                {
                    proc_name="/update/aliIoT4ovfs"
                    param1="/usr/etc/cfgfiles"
                    param2=""
                    param3=""
                    
                    if [ $curtimev3 -ge $totaltimev3 ] ; then
                            #str=$(ps); echo ${str} | grep -q $proc_name; ret=$?;
                            pidof ${proc_name##*/} > /dev/null;ret=$?;
                            if [ ${ret} -ne 0 ] ; then
                                    echo "name=$proc_name parm1=$param1 parm2=$param2 param3=$param3"
                                    echo "$(date) Starting up $proc_name .... $curRestartTimev3/$totalRestartTimev3";
                                    chmod +x ${proc_name};
                                    ${proc_name} $param1 $param2 $param3 &
                                    let curRestartTimev3++;
                            fi
                            let curtimev3=0;
                    else
                            let curtimev3++;   
                    fi
                    
                    if [ $curRestartTimev3 -ge $totalRestartTimev3 ] ; then
                            echo "$(date) $proc_name starup fail. need reboot";
                            reboot;
                    fi
                }

                {
                    if [ $curtimev4 -ge $totaltimev4 ] ; then
                            curEthIn=$(cat /sys/class/net/eth0/carrier);
                            if [ $curEthIn == 0 ] && [ $lstEthIn == 1 ] ; then
                                    killall aliIoT4ovfs;
                                    sleep 2;
                                    /update/aliIoT4ovfs /usr/etc/cfgfiles &
                            fi	
                            let lstEthIn=curEthIn;
                            
                            let curtimev4=0;
                    else
                            let curtimev4++;
                    fi
                }
fi                
                sleep 2;
        }
        done
}

