	reboot_4g=0;
	i=1
	while [  $i  -le  20  ] ; 
	do
		lsusb | grep -q "1286:4e3c"; local ret10=$?
		lsusb | grep -q "1782:4d10"; local ret11=$?
		lsusb | grep -q "05c6:9025"; local ret12=$?
		lsusb | grep -q "05c6:9625"; local ret13=$?
