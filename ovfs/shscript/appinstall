	fi 
	
	if [ -z $macaddr ];then
	byte0=$(head -c 32 /dev/urandom | md5sum | cut -c-2);
	byte1=$(head -c 32 /dev/urandom | md5sum | cut -c-2);
	byte2=$(head -c 32 /dev/urandom | md5sum | cut -c-2);
	byte3=$(head -c 32 /dev/urandom | md5sum | cut -c-2);
	byte4=$(head -c 32 /dev/urandom | md5sum | cut -c-2);
	macaddr=00:${byte0}:${byte1}:${byte2}:${byte3}:${byte4}

	fi

	echo -e "ifconfig eth0 down"
	ifconfig eth0 down
	echo -e "ifconfig eth0 hw ether $macaddr mtu 1400 up"
	ifconfig eth0 hw ether $macaddr mtu 1400 up
	echo -e "ifconfig eth0 $ipaddr netmask $ipmask"
	ifconfig eth0 $ipaddr netmask $ipmask
	route add default gw $gateway
	ifconfig lo up
}


