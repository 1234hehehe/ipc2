write_phy_extreg()
{
	local ext_reg=$1
	local value=$2
	echo w reg:0x0-0xd-0x1f > /proc/jz/mdio/cmd;
	echo w reg:0x0-0xe-$ext_reg > /proc/jz/mdio/cmd;
	echo w reg:0x0-0xd-0x401f > /proc/jz/mdio/cmd;
	echo w reg:0x0-0xe-$value > /proc/jz/mdio/cmd;
}
read_phy_extreg()
{
	local ext_reg=$1
	echo w reg:0x0-0xd-0x1f > /proc/jz/mdio/cmd;
	echo w reg:0x0-0xe-$ext_reg > /proc/jz/mdio/cmd;
	echo w reg:0x0-0xd-0x401f > /proc/jz/mdio/cmd;
	echo r reg:0x0-0xe > /proc/jz/mdio/cmd;
	cat /proc/jz/mdio/cmd;
}
resetphy()
{
	echo "reset generate phy";
	echo w reg:0x0-0x00-0x4000 > /proc/jz/mdio/cmd;
	sleep 1;
	echo w reg:0x0-0x00-0x3300 > /proc/jz/mdio/cmd;
}
resetdp83825()
{
	echo "reset phy dp83825";
	echo w reg:0x0-0x1f-0x8000 > /proc/jz/mdio/cmd;
	sleep 1;

	write_phy_extreg 0x30b 0xc80;
	write_phy_extreg 0x30c 0xe;
	write_phy_extreg 0x30e 0x5800;
}
guard_phy()
{
	echo getphy > /proc/jz/mdio/cmd 
	str=`cat /proc/jz/mdio/cmd`
	phy=${str#*:};
	echo "phy=$phy"

	if [ $phy == "0" ] ; then
		write_phy_extreg 0x30b 0xc80;
		read_phy_extreg 0x30b;
		write_phy_extreg 0x30c 0xe;
		read_phy_extreg 0x30c;
		write_phy_extreg 0x30e 0x5800;
		read_phy_extreg 0x30e;
		echo w reg:0x0-0x17-0x1e5 > /proc/jz/mdio/cmd;
		echo r reg:0x0-0x17 > /proc/jz/mdio/cmd;
		cat /proc/jz/mdio/cmd;
		echo dp83825
	elif [ $phy == "1" ] ; then
		echo sz18201
	else
		echo "phytype = $phy nosupport"
		return;
	fi

	gpiotool B 13 12ma;
	gpiotool B 14 12ma;
	gpiotool B 7 12ma;

	sleep 60;

	local nullcnt=0;
	local resetcnt=360;
	while true ; do
		str=`cat /proc/net/arp | grep eth0 | tr -d '\n'`
		ip=${str%% *}
		if [ -z "$ip" ] ; then
			sleep 10;
			let nullcnt++;
			if [ $nullcnt -gt $resetcnt ] ; then
				echo "$nullcnt gt $resetcnt";
				if [ $phy == "0" ] ; then
					resetdp83825;
				elif [ $phy == "1" ] ; then
					resetphy;
				fi
				nullcnt=0;
			fi
		else
			nullcnt=0;
			ret=1;
			while [ -n "$ip" ] ; do
				result=`arping -D -f -w 3 -I eth0 $ip | grep Unicast`
				if [ -n "$result" ] ; then
					echo "arping $ip ok";
					ret=0;
					break;
				else
					echo "arping $ip failed";
				fi
				str=${str#*eth0};
				ip=${str%% *};
			done
			if [ ${ret} -ne 0 ] ; then
				if [ $phy == "0" ] ; then
					resetdp83825;
				elif [ $phy == "1" ] ; then
					resetphy;
				fi
				sleep 180;
			fi
		fi
		sleep 3;
	done;
}
start_module()
{
	sysctl -w net.ipv4.tcp_tw_recycle=0;
	sysctl -w vm.drop_caches=3;
	date;free;
	syslogd -O /tmp/syslog.log -s 64 -b 8 -l 6;
	cd /root/ 
	echo "sysinit..."
	sysinit&
	
	ulimit -s 512;

	guard_phy &

	gpiotool B 13 12ma;
	gpiotool B 14 12ma;
	gpiotool B 7 12ma;

	gpiotool A 22 down;
	gpiotool C 4 up;

	echo 0 > /proc/sys/net/ipv4/neigh/default/gc_thresh1;

	echo "Start core..."
	ovfs_core&

	echo "Start boardsystem..."
	ovfs_boardsystem&
	sleep 6;

	echo "Start network..."
	ifconfig eth0 down;
	ovfs_network&

	echo "Start webserver..."
	ovfs_webserver&

	sleep 1;

	echo "update..."
	if [ -f /root/bin/update ] ; then
		pkill update
		cp /root/bin/update /dev/;
		cd /dev;./update&
		cd /;
	fi

	sleep 5;
	
	echo "start mediaserver"
	ovfs_mediaserver&
	
	ovfs_ptz&
#	mount_mmc &
	sdcard_format_respawn &
	
	libcount=$(ls /root/host_libs/ | wc -l)
	echo libcount=$libcount
	if [ $libcount -gt 0 ] ; then
		ovfs_access_host &
	fi
	
	guard_process &
	
	sleep 10;
	start_p2p
}

mount_mtd()
{
if [ ! -d /media ] ; then 
	mkdir /media -p
fi
	mount -t squashfs /dev/mtdblock5 /media > /dev/null;
if [ ! -d /usr/etc ] ; then 
	mkdir /usr/etc -p
fi
	mount -t jffs2 mtd:config /usr/etc 2> /dev/null;
	[ -f /usr/etc/factoryinfo.json ] || cp -af /update/etc/factoryinfo.json /usr/etc/factoryinfo.json;
	
	mount /update /root;

	[ -d /root/etc/sensor ] && ln -sf /root/etc/sensor /etc/sensor;
}

untar_pack()
{
	echo "untar packet..."
	for tarfile in /update/*.tar.xz ; do
		filename=$(basename $tarfile | sed -e "s/.tar.xz//");
		cp $tarfile /var/untar;
		xz -d /var/untar/$filename.tar.xz;
		tar -xvf /var/untar/$filename.tar -C /var/untar;
		rm /var/untar/$filename.tar;
		ln -s /var/untar/$filename /root/$filename
	done
	
	mkdir -p /tmp/nginx/logs && ln -s /tmp/nginx/logs /root/nginx/logs
	echo "untar packet...ok"
}

